{
  "name": "smaltbi",
  "version": "0.2.0",
  "description": "Browser-based business intelligence on smaltdb: fast, simple, powerful, beautiful",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-packed.mjs && node scripts/vendor-smaltdb.mjs",
    "vendor": "node scripts/vendor-smaltdb.mjs",
    "sample": "node scripts/make-sample.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "publish:report": "node scripts/publish.mjs",
    "site": "node scripts/build.mjs && node scripts/site.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --tests && node --test dist-test/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node test/e2e.mjs",
    "check": "npm run typecheck && npm test",
    "deps": "node scripts/fetch-packed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "hyparquet-compressors": "^1.1.2",
    "typescript": "~7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "smaltkit": "github:stenhoor/smaltkit#4689df111e4a3cfcc7648b2a9af65d7de45a081d"
  }
}
