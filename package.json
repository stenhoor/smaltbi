{
  "name": "smaltbi",
  "version": "0.1.0",
  "description": "Browser-based business intelligence on smaltdb: fast, simple, powerful, beautiful",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-smaltdb.mjs",
    "vendor": "node scripts/vendor-smaltdb.mjs",
    "sample": "node scripts/make-sample.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "publish:report": "node scripts/publish.mjs",
    "site": "node scripts/build.mjs && node scripts/site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --tests && node --test dist-test/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node test/e2e.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smaltdb": "^0.8.3"
  }
}
